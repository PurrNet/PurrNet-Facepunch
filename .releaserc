{
  "branches": [
    {
      "name": "release",
      "channel": "latest",
      "type": "release"
    },
    {
      "name": "dev",
      "prerelease": "beta"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer", 
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "Assets/PurrNetFacepunch/CHANGELOG.md"
    }],
    ["semantic-release-replace-plugin", {
        "replacements": [
          {
            "files": ["Assets/PurrNetFacepunch/package.json"],
            "from": "\"version\": \".*?\"",
            "to": "\"version\": \"${nextRelease.version}\"",
            "countMatches": true
          }
        ]
    }],
    ["@semantic-release/git", {
        "assets": ["Assets/PurrNetFacepunch/package.json", "Assets/PurrNetFacepunch/CHANGELOG.md"],
        "message": "ci(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    "@semantic-release/github"
  ]
}
